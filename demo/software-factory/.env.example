# Copy to .env (gitignored). factory/bin/factory loads it; values already set in
# the environment win. Nothing here is needed for `factory demo` (mock mode).

# Claude Code credentials. Leave empty if you have run `claude login` instead;
# never commit a real key.
ANTHROPIC_API_KEY=

# The Claude Code binary the runner spawns for each agent. `factory demo` sets
# this to factory/mock/claude for you.
FACTORY_CLAUDE_BIN=claude

# Extra flags for every `claude -p` call, e.g. a spend cap per agent run.
FACTORY_CLAUDE_FLAGS=--max-budget-usd 5

# How many times the builder may be resumed after review round 1 (so at most
# FACTORY_MAX_RESUMES + 1 review rounds per run).
FACTORY_MAX_RESUMES=2

# Branch that approved jobs merge into.
FACTORY_BASE_BRANCH=main

# Where `factory demo` builds its throwaway repo.
FACTORY_SANDBOX=/tmp/software-factory-demo

# Seconds the mock agents pause so the dashboard visibly moves. 0 for instant.
FACTORY_MOCK_DELAY=1.5
